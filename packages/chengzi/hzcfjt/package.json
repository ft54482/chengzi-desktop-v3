{
  "name": "dsh-plugin-chengzi-hzcfjt",
  "description": "Chengzi Pro generate_hzcfjt_ppt agent tool: bespoke report decks for 海珠城发集团 following the customer's five-chapter template, with the customer-approved verbatim head pages shipped as a binary asset",
  "version": "3.0.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "assets/**"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "plugin",
    "chengzi",
    "hzcfjt",
    "ppt"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  }
}
